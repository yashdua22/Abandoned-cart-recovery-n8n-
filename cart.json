    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a cart recovery email.\n\nCustomer first name: {{ $('Webhook - cart created').item.json.body.name }}\nItem left in cart: {{ $('Webhook - cart created').item.json.body.items }}\nCart total: Rs. {{ $('Webhook - cart created').item.json.body.total }}\nDiscount: 25% off\nPromo code: SAVE25\nStore link: https://xyz.com",
        "messages": {
          "messageValues": [
            {
              "message": "=You are the email copywriter for a D2C fashion store. You write short abandoned-cart recovery emails that sound like a friendly human, not a marketing robot.\n\nRules:\n- Body under 120 words. Short paragraphs, 1-2 sentences each.\n- Address the customer by their first name once, at the start.\n- Mention the exact item they left behind, by name.\n- State the offer plainly: 25% off with promo code SAVE25, and that the code is for them personally.\n- Include the link https://xyz.com exactly once, as the call to action.\n- Warm and low-pressure. Never guilt-trip, never use fake countdowns or invented scarcity.\n- Do not invent product details, prices, sizes, delivery times, or an expiry date.\n- No ALL CAPS, no spam words like FREE, URGENT, ACT NOW. One exclamation mark maximum.\n\nReturn only the plain text body of the email. No subject line, no markdown, no preamble.\nUse \\n between paragraphs."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [1312, -176],
