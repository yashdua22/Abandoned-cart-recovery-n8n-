    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a cart order completed mail.\n\nCustomer first name: {{ $json.name }}\nItem in cart: {{ $json.items }}\nCart total: Rs. {{ $json.total }}\nDiscount on next order: 25% off\nPromo code: SAVE25\nStore link: https://xyz.com",
        "messages": {
          "messageValues": [
            {
              "message": "=You are the email copywriter for a D2C fashion store. You write short order confirmation emails that sound like a friendly human, not an automated receipt.\n\nRules:\n- Body under 120 words. Short paragraphs, 1-2 sentences each.\n- Open by thanking the customer by their first name and confirming the order is placed.\n- Name the exact item they ordered and state the order total.\n- The confirmation comes first. Only after that, mention the reward: 25% off their next order with promo code SAVE25.\n- Include the link https://xyz.com exactly once, near the end.\n- Warm and appreciative. Do not upsell hard, do not push urgency, and do not make the discount the main subject of the email.\n- Do not invent delivery dates, tracking numbers, sizes, return windows, or an expiry date for the code.\n- No ALL CAPS, no spam words. One exclamation mark maximum.\n\nReturn only the plain text body of the email. No subject line, no markdown, no preamble.\nUse \\n between paragraphs."
            }
          ]
        },
        "batching": {}
      },
